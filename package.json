{
  "name": "mfe-communication-poc",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.5"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build:packages": "pnpm --filter @platform/contracts --filter @platform/tsconfig build && pnpm --filter @platform/debug-panel build:lib && pnpm --filter @platform/mfe-communication build && pnpm --filter @platform/debug-panel build:panel",
    "build": "pnpm build:packages && pnpm -r --filter \"./apps/*\" build",
    "remotes:generate": "node scripts/generate-remotes.mjs",
    "start": "pnpm --parallel --filter \"./apps/*\" serve",
    "test": "pnpm -r --if-present test && pnpm exec vitest run --config vitest.boundaries.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm typecheck",
    "prove:split": "node scripts/prove-separate-repos.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core", "core-js", "esbuild", "sass"]
  }
}
