{
  "name": "@platform/mfe-communication",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js",
      "default": "./dist/host.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@platform/contracts": "^1.0.0",
    "@platform/debug-panel": "^1.0.0",
    "mitt": "3.0.1",
    "zustand": "5.0.8"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@platform/tsconfig": "^1.0.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
