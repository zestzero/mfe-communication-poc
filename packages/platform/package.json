{
  "name": "@platform/debug-panel",
  "version": "1.0.0",
  "type": "module",
  "files": ["dist", "src"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build:lib": "tsc -p tsconfig.lib.json",
    "build:panel": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@platform/contracts": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "@platform/mfe-communication": "^1.0.0"
  },
  "devDependencies": {
    "@platform/mfe-communication": "^1.0.0",
    "@platform/tsconfig": "^1.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
